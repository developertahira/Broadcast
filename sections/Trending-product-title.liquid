<div class="Collection-List-Hover-Container" style="background-image: url('{{ section.settings.bg_best_img | img_url: 'master' }}'); height: 300px; width: 100%">
     <div class="collection-hover-inner-frame-container">
           {% comment %}
            select list of products and display it's title only with Superscript value
           {% endcomment %}
           <div class="collection-selector">
            {% for collection in section.settings.selected_Trending_collections %}
              <div class="collection-item">
                <a href="{{ collection.url }}">
                    <h2>{{ collection.title }}<sup>{{ collection.products_count }}</sup></h2>
                </a>
              </div>
            {% endfor %}

          </div>
     </div>
</div>
<style>
    .collection-selector {
        display: flex;
        gap: 20px;
        justify-content: center;
    }
    .Collection-List-Hover-Container {
        width: 100%;
        background-repeat: no-repeat;
    }
</style>
{% schema %}
{
    "name": "Trending Collection Title",
    "settings": [
        {
            "type": "image_picker",
            "id": "bg_best_img",
            "label": "Select img"
        },
         {
      "type": "collection_list",
      "id": "selected_Trending_collections",
      "label": "Select Collections"
    }
        ],
        "presets": [
            {
                "name": "Trending Collection"
            }
        ]
}
{% endschema %}"