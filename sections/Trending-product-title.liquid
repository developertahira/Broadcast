<div class="Collection-List-Hover-Container" style="background-image: url('{{ section.settings.bg_best_img | img_url: 'master' }}'); height: 650px; width: 100%">
    <div class="collection-hover-inner-frame-container">
        <div class="collection-selector">
            {% for collection in section.settings.selected_Trending_collections %}
                <div class="collection-item" data-bg-image="{{ collection.image | img_url: 'master' }}">
                    <h2>{{ collection.title }}</h2>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<style>
/* Desktop view */
.collection-selector {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
}

.Collection-List-Hover-Container {
    width: 100%;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    transition: background-image 0.3s ease-in-out;
    margin: 0px 0px 50px 0px;
}

.collection-item h2 {
    transition: color 0.3s ease;
    color: white;
    opacity: 0.5;
    font-size: 3rem;
    text-align: center;
}

.collection-item:hover h2 {
    opacity: 1;
}

/* Mobile view at 790px or below */
@media (max-width: 790px) {
    .collection-selector {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 40px;
        position: relative;
        z-index: 2;
    }

    .Collection-List-Hover-Container {
        height: 100vh;
        position: relative;
        overflow: hidden;
    }

    .collection-item h2 {
        font-size: 2rem;
    }

    .Collection-List-Hover-Container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('{{ section.settings.bg_best_img | img_url: "master" }}');
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
        z-index: 1;
        transition: background-image 0.3s ease-in-out;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('.Collection-List-Hover-Container');
    const items = document.querySelectorAll('.collection-item');

    // Handle hover effect for desktop
    items.forEach(item => {
        const bgImage = item.getAttribute('data-bg-image');

        item.addEventListener('mouseenter', () => {
            container.style.backgroundImage = `url(${bgImage})`;
        });

        item.addEventListener('mouseleave', () => {
            container.style.backgroundImage = `url('{{ section.settings.bg_best_img | img_url: "master" }}')`;
        });
    });

    // Handle scrolling and dynamic title highlighting for mobile
    if (window.innerWidth <= 790) {
        const observer = new IntersectionObserver(
            entries => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        container.style.backgroundImage = `url(${entry.target.getAttribute('data-bg-image')})`;
                        entry.target.querySelector('h2').style.color = 'gold'; // Highlight title
                    } else {
                        entry.target.querySelector('h2').style.color = 'white'; // Reset title color
                    }
                });
            },
            { root: null, threshold: 0.5 } // Adjust threshold for triggering
        );

        items.forEach(item => observer.observe(item));
    }
});
</script>

{% schema %}
{
    "name": "Trending Collection Title",
    "settings": [
        {
            "type": "image_picker",
            "id": "bg_best_img",
            "label": "Default Background Image"
        },
        {
            "type": "collection_list",
            "id": "selected_Trending_collections",
            "label": "Select Collections"
        }
    ],
    "presets": [
        {
            "name": "Trending Collection"
        }
    ]
}
{% endschema %}
