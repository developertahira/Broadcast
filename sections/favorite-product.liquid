<div class="favourit-product-main-container" style="background-image: url('{{ section.settings.fp_bg_img | img_url: 'master' }}'); height: 60vh;">
  <div class="inner-fp-container">
    <div class="fb-content">
      <h2 class="fp-head">{{ section.settings.fp_heading }}</h2>
      <p class="fp-para">{{ section.settings.fp_Discription }}</p>
      <a href="{{ section.settings.fp_button_link }}" class="fp-button">
        {{ section.settings.fp_button_text }}
      </a>
    </div>
    <div class="fp-product-container">
      {% if section.settings.fp_selected_product %}
        {% assign product = all_products[section.settings.fp_selected_product] %}
        {% if product %}
          <div class="fp-product-card">
            <div class="product-fp-image">
              <a href="{{ product.url }}">
                <img src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}">
              </a>
            </div>
            <div class="fp-product-info">
              <a class="product-title">{{ product.title }}</a>
              <div class="f-product-pricing">
                <span class="current-price">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="original-price">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
              <p class="product-description">{{ product.description | truncate: 100 }}</p>
            </div>
          </div>
        {% else %}
          <p>Product not found.</p>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

<style>
  .favourit-product-main-container {
  width: 100%;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  position: relative;
}

.inner-fp-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 50px;
  height: 100%;
}

.fb-content {
  width: 50%;
  color: white;
  padding: 100px 50px 50px 50px;

  
}

.fp-head {
  font-size: 3rem;
  margin-bottom: 20px;
  line-height: 1.2;
  color: white;
}

.fp-para {
  font-size: 1rem;
  margin-bottom: 20px;
}

.fp-button {
  background-color: white;
  color: black;
  padding: 10px 20px;
  text-decoration: none;
  font-size: 1rem;
  border-radius: 5px;
  display: inline-block;

}

.fp-button:hover {
  background-color: #444;
}

.fp-product-container {
   padding: 20px;

}


.fp-product-card {
  padding: 100px 20px 20px 20px;
  border-radius: 8px;

  display: flex;
  

}

.product-fp-image {
  text-align: center;
  margin-bottom: -10px;
}

.product-fp-image img {
  width: 100%;
  height: 95%;

}

.fp-product-info {
  text-align: left;
  padding: 21px;
  background-color: #f5f2ec;
}

.product-title {
  font-size: 1.2rem;
  font-weight: bold;
  margin-bottom: 10px;
}

.f-product-pricing {
  margin-bottom: 10px;
}

.current-price {
  font-size: 1.2rem;
  font-weight: bold;
  color: #000;
}

.original-price {
  font-size: 1rem;
  color: #999;
  text-decoration: line-through;
  margin-left: 10px;
}

.product-description {
  font-size: 0.9rem;
  color: #555;
}
@media (max-width: 990px) {
  .favourit-product-main-container {
    height: 85vh !important;
}
  .inner-fp-container {
    display: block; 
  }
  .fp-product-card {
    padding: 0px;
    margin: 0px;
  }
  .product-fp-image img {
    height: 96%;
  }
  .fb-content {
    width: 100%;
  }
}
  
</style>
{% schema %}
  {
    "name": "Favourite Product",
    "settings": [
      {
        "type": "image_picker",
        "id": "fp_bg_img",
        "label": "Select image"
      },
      {
        "type": "text",
        "id": "fp_heading",
        "label": "Heading"
      },
      {
        "type": "text",
        "id": "fp_Discription",
        "label": " Descrition"
      },
      {
        "type": "url",
        "id": "fp_button_link",
        "label": "Button Link"
      },
      {
        "type": "text",
        "id": "fp_button_text",
        "label": "Button Text"
      },
      {
        "type": "product",
        "id": "fp_selected_product",
      "label": "Select a Product"
      }
    ],
    "presets": [
      {
        "name": "Favorit products"
      }
    ]
  }
{% endschema %}