{{ 'Ethical-products.css' | asset_url | stylesheet_tag }}

<div class="content-contain">
    <p class="cont-caption">{{section.settings.eth_caption}}</p>
    <h2 class="cont-head">{{section.settings.heading}}</h2>
    <p class="cont-discript">{{section.settings.description}}</p>
</div>
<div class="Ethical-cards-cont">
   
    <div class="eth-Timeless brick-block">
        <div class="bg-image-contain">
        <img src="{{ section.settings.timeless_img| img_url: 'master' }}" alt="TImeless" />
        </div>
        <div class="eth-overlay backgrop-radial">
            <h1 class="overlay-heading" >{{section.settings.eth_ring_heading}}</h1>
            <p class="overlay-para">{{section.settings.ring_description}}</p>
            {% if section.settings.button_Text %}
                <a href="#" class="eth-button">
                  {{ section.settings.button_Text }}
                </a>
            {% endif %}
        </div>
    </div>
    <div class="eth-Ring brick-block">
        <div class="bg-image-contain">
        <img src="{{ section.settings.ring_img| img_url: 'master' }}" alt="Ring" />
        </div>
        <div class="eth-overlay backgrop-radial">
            <h1 class="overlay-heading">{{ section.settings.eth_timeless_heading }}</h1>
            <p class="overlay-para">{{ section.settings.Timeless_description }}</p>
            {% if section.settings.button_timeless %}
                <a href="#" class="eth-button">
                    {{ section.settings.button_timeless }}
                </a>
            {% endif %}
        </div>
        
    </div>
</div>
{% schema %}
{
    "name": "Ethical Products",
    "settings": [
        {
            "type": "text",
            "id": "eth_caption",
            "label": "Caption"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Ethical-heading"
        },
        {
            "type": "text",
            "id": "description",
            "label": "Description"
        },
        {
            "type": "image_picker",
            "id": "ring_img",
            "label": "select ring image"
        },
        {
            "type": "text",
            "id": "eth_ring_heading",
            "label": "Ring-Heading"
        },
        {
            "type": "text",
            "id": "ring_description",
            "label": "Description"
        },
        {
            "type": "text",
            "id": "button_Text",
            "label": "ring-Button"
        },
        {
            "type": "image_picker",
            "id": "timeless_img",
            "label": "select Timeless image"
        },
        {
            "type": "text",
            "id": "eth_timeless_heading",
            "label": "Timeless-Heading"
        },
        {
            "type": "text",
            "id": "Timeless_description",
            "label": "Description"
        },
        {
            "type": "text",
            "id": "button_timeless",
            "label": "Timeless-Button"
        }
        ],
        "presets": [
            {
                "name": "Ethical Products"
            }
        ]
}
{% endschema %}