<div class="content-contain">
    <p class="cont-caption">{{section.settings.eth_caption}}</p>
    <h2 class="cont-head">{{section.settings.heading}}</h2>
    <p class="cont-discript">{{section.settings.description}}</p>
</div>
<div class="Ethical-cards-cont">
   
    <div class="eth-Timeless brick-block">
        <div class="bg-image-contain">
        <img src="{{ section.settings.timeless_img| img_url: 'master' }}" alt="TImeless" />
        </div>
        <div class="eth-overlay backgrop-radial">
            <h1 class="overlay-heading" >{{section.settings.eth_ring_heading}}</h1>
            <p class="overlay-para">{{section.settings.ring_description}}</p>
            {% if section.settings.button_Text %}
                <a href="#" class="eth-button">
                  {{ section.settings.button_Text }}
                </a>
            {% endif %}
        </div>
    </div>
    <div class="eth-Ring brick-block">
        <div class="bg-image-contain">
        <img src="{{ section.settings.ring_img| img_url: 'master' }}" alt="Ring" />
        </div>
        <div class="eth-overlay backgrop-radial">
            <h1 class="overlay-heading">{{ section.settings.eth_timeless_heading }}</h1>
            <p class="overlay-para">{{ section.settings.Timeless_description }}</p>
            {% if section.settings.button_timeless %}
                <a href="#" class="eth-button">
                    {{ section.settings.button_timeless }}
                </a>
            {% endif %}
        </div>
        
    </div>
</div>
{% comment %} 

        .backgrop-radial {
            position: relative; /* Required for positioning the pseudo-element */
            z-index: 1; /* Ensures the content is above the background */
        }

        .backgrop-radial::before {
            content: ""; /* Required for pseudo-element to render */
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(black, transparent);
            opacity: 0.25; /* Applies only to the pseudo-element */
            z-index: -1; /* Places the pseudo-element behind the content */
            pointer-events: none; /* Ensures it doesn't interfere with user interactions */
        }

{% endcomment %}
<style>


        .content-contain {
            padding: 100px 0px 30px 50px;
    }
    .content-contain .cont-caption {
        font-size: 1.5rem;
        margin-bottom: 0px;
        margin-top: 0px;
    }
    .content-contain .cont-head {
        font-size: 3rem;
        margin-top: 0px;
        margin-bottom: 14px;
        }
        .content-contain .cont-discript {
            font-size: 1.5rem;
            margin-top: 0px;
            margin-bottom: 0px;
        }
    .Ethical-cards-cont {
        display: flex;
        width: 100%;
        gap:32px;
        max-width: none;
        margin: 0 auto;
        padding: 0px 50px 82px 50px;
    }
    .brick-block {
        width: 100%;
        position: relative;
    }
    .bg-image-contain img{
        width: 100%;
        height: 450px;
        display: flex; 
        align-items: center;
        object-fit: cover;
    }
    .eth-overlay {
        display: flex;
        flex-direction: column;
        padding: 50px;
        overflow-wrap: break-word;
        color: white;
        position: absolute;
        bottom: 0;
    }
    .overlay-heading, .overlay-para {
        margin-top: 0px;
        margin-bottom: 1rem;
        
    }
    .overlay-para {
        font-family:  'Montsarrat', sans-serif;
    }
   
     .overlay-heading {
        font-size: 36.8px;
        font-family: "IT Noveresa",serif;
        font-style: normal;
        font-weight: 400;
        letter-spacing: 0.0em;
        line-height: 1.2;
    }
        a.eth-button {
        color: white;
        text-decoration: none;
        border: 1px solid white; 
        width: 122px;
        text-align: center;
        padding: 10px;

   }

    @media (min-width: 750px) {
        .Ethical-cards-cont {
            flex-wrap: nowrap;
        }
        .brick-block {
          flex: 1 1 50%;
        }
    }
    @media (max-width: 749px) { 
    .Ethical-cards-cont {
        display: flex; /* Maintain flex layout */
        flex-direction: column; /* Stack containers vertically */
        width: 100%; /* Ensure full width */
        gap: 16px; /* Maintain gap between items */
        padding: 0px 16px 82px 16px;
    }

    .brick-block {
        width: 100%; /* Each container takes full width */
        flex: 0 0 auto; /* Prevent shrinking or growing */
    }
    .eth-overlay {
        padding: 15px;
    }
    .content-contain {
           padding-left: 16px;
           padding-right: 16px;
    }
}
</style>
