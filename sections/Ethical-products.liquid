<div class="content-contain">
    <p class="cont-caption">{{section.settings.eth_caption}}</p>
    <h2 class="cont-head">{{section.settings.heading}}</h2>
    <p class="cont-discript">{{section.settings.description}}</p>
</div>
<div class="Ethical-cards-cont">
   
    <div class="eth-Timeless brick-block">
        <div class="bg-image-contain">
        <img src="{{ section.settings.timeless_img| img_url: 'master' }}" alt="TImeless" />
        </div>
        <div class="eth-overlay">
            <h1 class="overlay-heading" >{{section.settings.eth_ring_heading}}</h1>
            <p class="overlay-para">{{section.settings.ring_description}}</p>
            {% if section.settings.button_Text %}
                <a href="#" class="eth-button">
                  {{ section.settings.button_Text }}
                </a>
            {% endif %}
        </div>
    </div>
    <div class="eth-Ring brick-block">
        <div class="bg-image-contain">
        <img src="{{ section.settings.ring_img| img_url: 'master' }}" alt="Ring" />
        </div>
        <div class="eth-overlay">
            <h1 class="overlay-heading">{{section.settings.eth_timeless_heading}}</h1>
            <p class="overlay-para">{{section.settings.Timeless_description}}</p>
            {% if section.settings.button_timeless %}
                <a href="#" class="eth-button">
                  {{ section.settings.button_timeless }}
                </a>
              {% endif %}
              
        </div>
    </div>
</div>
<style>
        .content-contain {
      padding: 50px;
    }
    .content-contain .cont-caption {
        font-size: 2rem;
        margin-bottom: 0px;
    }
    .content-contain .cont-head {
        font-size: 4rem;
        margin-top: 0px;
        margin-bottom: 14px;
        }
        .content-contain .cont-discript {
            font-size: 2rem;
            margin-top: 0px;
        }
    .Ethical-cards-cont {
        display: flex;
        width: 100%;
        gap:32px;
        max-width: none;
        margin: 0 auto;
        padding: 0px 50px 82px 50px;
    }
    .brick-block {
        width: 100%;
        position: relative;
    }
    .bg-image-contain img{
        width: 100%;
        height: 450px;
        display: flex; 
        align-items: center;
        object-fit: cover;
    }
    .eth-overlay {
        display: flex;
        flex-direction: column;
        padding: 50px;
        overflow-wrap: break-word;
        color: white;
        position: absolute;
        bottom: 0;
    }
    .overlay-heading, .overlay-para {
        margin-top: 0px;
        margin-bottom: 1px;
    }
        a.eth-button {
        color: white;
        text-decoration: none;
        border: 1px solid white;
        width: 100px;
   }

    @media (min-width: 750px) {
        .Ethical-cards-cont {
            flex-wrap: nowrap;
        }
        .brick-block {
          flex: 1 1 50%;
        }
    }
    @media (max-width: 749px) {
    .Ethical-cards-cont {
        display: flex; /* Maintain flex layout */
        flex-direction: column; /* Stack containers vertically */
        width: 100%; /* Ensure full width */
        gap: 32px; /* Maintain gap between items */
    }

    .brick-block {
        width: 100%; /* Each container takes full width */
        flex: 0 0 auto; /* Prevent shrinking or growing */
    }
}
</style>
{% schema %}
{
    "name": "Ethical Products",
    "settings": [
        {
            "type": "text",
            "id": "eth_caption",
            "label": "Caption"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Ethical-heading"
        },
        {
            "type": "text",
            "id": "description",
            "label": "Description"
        },
        {
            "type": "image_picker",
            "id": "ring_img",
            "label": "select ring image"
        },
        {
            "type": "text",
            "id": "eth_ring_heading",
            "label": "Ring-Heading"
        },
        {
            "type": "text",
            "id": "ring_description",
            "label": "Description"
        },
        {
            "type": "text",
            "id": "button_Text",
            "label": "ring-Button"
        },
        {
            "type": "image_picker",
            "id": "timeless_img",
            "label": "select Timeless image"
        },
        {
            "type": "text",
            "id": "eth_timeless_heading",
            "label": "Timeless-Heading"
        },
        {
            "type": "text",
            "id": "Timeless_description",
            "label": "Description"
        },
        {
            "type": "text",
            "id": "button_timeless",
            "label": "Timeless-Button"
        }
        ],
        "presets": [
            {
                "name": "Ethical Products"
            }
        ]
}
{% endschema %}