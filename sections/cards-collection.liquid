
<div class="custom-card-collection">
  {% for block in section.blocks %}
    {% if block.type == "Card-selection" %}
      <div class="custom-card">
        {% if block.settings.card_img %}
          <img src="{{ block.settings.card_img | img_url: '300x300' }}" alt="{{ block.settings.heading }}" />
        {% endif %}
        
        {% if block.settings.heading %}
          <h3>{{ block.settings.heading }}</h3>
        {% endif %}
        
        {% if block.settings.text %}
          <p>{{ block.settings.text }}</p>
        {% endif %}
        
        {% if block.settings.show_more_link %}
          <a href="{{ block.settings.show_more_link }}">{{ block.settings.show_more_text }}</a>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>
{% comment %}
   
{% endcomment %}
<style>
.custom-card-collection {
  display: grid;
  grid-template-columns: repeat(3, 1fr); /* 3 cards per row */
  gap: 20px; /* Space between cards */
  margin-bottom: 50px;
  flex-wrap: wrap;
}

.custom-card {
  border: 1px solid #ddd;
  padding: 15px;
 /*  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  background-color: #fff; */
  text-align: center;
}

.custom-card img {
  max-width: 100%;
  height: auto;
  margin-bottom: 10px;
}

.custom-card h3 {
  font-size: 18px;
  margin: 10px 0;
}

.custom-card p {
  font-size: 14px;
  color: #666;
}

.custom-card a {
  display: inline-block;
  margin-top: 10px;
  color: #0073e6;
  text-decoration: none;
}

.custom-card a:hover {
  text-decoration: underline;
}

</style>


{% schema %}
{
    "name": "Card-Collection",
    "settings": [
        
        ],
        "blocks": [
    {
      "type": "Card-selection",
      "name": "Cards",
      "settings": [
        {
          "type": "image_picker",
          "id": "card_img",
          "label": "select Card Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Card-heading"
        },
        {
            "type": "text",
            "id": "text",
            "label": "Enter text"
        },
        {
        "type": "text",
        "id": "show_more_text",
        "label": "Show more text",
        "default": "Show more"
        },
        {
        "type": "url",
        "id": "show_more_link",
        "label": "Show more link"
        }

      ]
    }
  ],
  "presets": [
    {
        "name": "Card"
    }
  ]
}
{% endschema %}