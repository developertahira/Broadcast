<div class="product-img-main-container">
  <!-- Product Section - Will appear first on mobile -->
  <div class="Featured-Prod-contan-slid">
    {% if section.settings.slid_featured_prod %}
      <div class="Inner-prod-cond">
        {% for product in section.settings.slid_featured_prod %}
          <div class="Specific-product-item">
            <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title }}">
            <div class="prod-card-label">
              {% if product.tags contains "Quick Add" %}
                <span class="quick-add-label">Quick Add</span>
              {% elsif product.tags contains "Pre-order" %}
                <span class="pre-order-label">Pre-order</span>
              {% endif %}
            </div>
            <h3>{{ product.title }}</h3>
            <p>{{ product.price | money }}</p>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p>No featured products selected.</p>
    {% endif %}
  </div>

  <!-- Image Slider Section - Will appear second on mobile -->
  <div class="img-slider-container">
    <div class="image-slider">
      {% if section.settings.slider_img1 %}
        <img src="{{ section.settings.slider_img1 | img_url: 'master' }}" alt="Slider Image 1" class="slider-image">
      {% endif %}
      {% if section.settings.slider_img2 %}
        <img src="{{ section.settings.slider_img2 | img_url: 'master' }}" alt="Slider Image 2" class="slider-image">
      {% endif %}
    </div>
  </div>
</div>

<style>
.product-img-main-container {
  width: 100%;
  display: flex;
  justify-content: center;
  flex-direction: row; /* Default: side by side */
}

/* Desktop styles (750px and up) */
.Featured-Prod-contan-slid {
  width: 50%;
  background-color: #f5f2ec;
}

.img-slider-container {
  width: 50%;
  height: 800px;
  background-image: url('{{ section.settings.bg_img | img_url: "master" }}');
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  position: relative;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.image-slider {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 80%;
  height: 40%;
  overflow-y: scroll;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

/* Mobile styles (749px and below) */
@media (max-width: 749px) {
  .product-img-main-container {
    flex-direction: column; /* Stack vertically on mobile */
    position: relative;
    height: auto;
  }
  
  .Featured-Prod-contan-slid {
    width: 100%;
    position: relative;
    z-index: 1;
    padding-bottom: 20px; /* Space before slider */
  }
  
  .img-slider-container {
    width: 100%;
    height: 60vh; /* Adjust based on your needs */
    position: sticky;
    top: 0; /* Stick to the top of viewport */
    z-index: 2;
    background-attachment: fixed; /* Optional: for parallax effect */
  }
  
  .image-slider {
    height: 80%; /* Take more space on mobile */
  }
  
  .Inner-prod-cond {
    margin-top: 20px; /* Reduced margin on mobile */
  }
}

/* Common styles for both desktop and mobile */
.image-slider::-webkit-scrollbar {
  display: none;
}

.image-slider img {
  width: 80%;
  max-width: 100%;
  height: auto;
  object-fit: cover;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease, opacity 0.3s ease;
  margin-bottom: 15px; /* Space between images */
}

.Inner-prod-cond {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 100px;
}

.Specific-product-item {
  text-align: center;
  background-color: white;
  color: black;
  margin: 10px;
  padding: 15px;
  width: 200px;
}

.prod-card-label {
  background-color: rgb(248 244 244 / 52%);
  margin-top: -10px;
  padding: 10px;
}

.prod-card-label span {
  color: black;
  text-transform: uppercase;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const slider = document.querySelector(".image-slider");
  let isDragging = false;
  let startY;
  let scrollTop;

  slider.addEventListener("mousedown", (event) => {
    isDragging = true;
    startY = event.pageY - slider.offsetTop;
    scrollTop = slider.scrollTop;
    slider.style.cursor = "grabbing";
    slider.style.userSelect = "none";
  });

  slider.addEventListener("mousemove", (event) => {
    if (!isDragging) return;
    const y = event.pageY - slider.offsetTop;
    const walk = y - startY;
    slider.scrollTop = scrollTop - walk;
  });

  slider.addEventListener("mouseup", () => {
    isDragging = false;
    slider.style.cursor = "grab";
  });

  slider.addEventListener("mouseleave", () => {
    isDragging = false;
    slider.style.cursor = "grab";
  });

  // Touch events for mobile
  slider.addEventListener("touchstart", (event) => {
    isDragging = true;
    startY = event.touches[0].pageY - slider.offsetTop;
    scrollTop = slider.scrollTop;
    event.preventDefault(); // Prevent default touch behavior
  });

  slider.addEventListener("touchmove", (event) => {
    if (!isDragging) return;
    const y = event.touches[0].pageY - slider.offsetTop;
    const walk = y - startY;
    slider.scrollTop = scrollTop - walk;
    event.preventDefault(); // Prevent default touch behavior
  });

  slider.addEventListener("touchend", () => {
    isDragging = false;
  });
});
</script>
{% schema %}
{
    "name": "Product-img-slider",
    "settings": [
        {
         "type":  "image_picker",
         "id": "bg_img",
         "label": "bg-img"  
        },
        {
            "type": "image_picker",
            "id": "slider_img1",
            "label": "First Image"
        },
        {
            "type": "image_picker",
            "id": "slider_img2",
            "label": "Second Image"
        },
        {
            "type": "product_list",
            "id": "slid_featured_prod",
            "label": "Select Featured Products"
        }
        ],
        "presets": [
            {
                "name": "Product-img-slider"
            }
        ]
}
{% endschema %}