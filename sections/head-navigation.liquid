
<link rel="stylesheet" href="{{ 'custom-header.css' | asset_url }}">

<div class="main-container">
  <div class="inner-container">
    <div class="menu">
    {% if section.settings.custom_menu %}
      <nav>
        <ul>
          {% for link in linklists[section.settings.custom_menu].links %}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
    </div>
    <div class="social-media-icons">
  {% if section.settings.tiktock_link %}
    <a href="{{ section.settings.tiktock_link }}" target="_blank" rel="noopener noreferrer">
      <img src="{{ 'icon-tiktock.svg' | asset_url }}" alt="tiktock">
    </a>
  {% endif %}
  {% if section.settings.insta_link %}
    <a href="{{ section.settings.insta_link}}" target="_blank" rel="noopener noreferrer">
      <img src="{{ 'icon-insta.svg' | asset_url }}" alt="insta">
    </a>
  {% endif %}
  </div>

  </div>
</div>


  
  {% if shop.enabled_currencies.size > 1 %}
    <div class="currency-selector">
      <form method="get" action="/cart">
        <select name="currency" id="currency" onchange="this.form.submit()">
          {% for currency in shop.enabled_currencies %}
            <option value="{{ currency }}" {% if currency == cart.currency %}selected{% endif %}>
              {{ currency }}
            </option>
          {% endfor %}
        </select>
      </form>
    </div>
  {% endif %}
  {% render 'currency-selector' %}

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
        "type": "link_list",
        "id": "custom_menu",
        "label": "select a menu"
    },
    {
        "type": "url",
      "id": "tiktock_link",
      "label": "tiktock Link"
    },
    {
        "type": "url",
      "id": "insta_link",
      "label": "insta Link"
    }
  ],
  "presets": [
    {
      "name": "top-header",
      "category": "Header"
    }
  ]
}
{% endschema %}

