    {% schema %}
        {
          "name": "Collection Slider",
          "settings": [
            {
            "type": "text",
            "id": "Ring_heading",
            "label": " Ring heading"
          },
            {
              "type": "image_picker",
              "id": "Ring_image",
              "label": "Ring Image"
            },
            {
              "type": "url",
              "id": "ring_link",
              "label": "Button Url"
            },
            {
              "type": "collection",
              "id": "rings_collection",
              "label": "Rings Collection"
            },
            {
              "type": "collection",
              "id": "earrings_collection",
              "label": "Earrings Collection"
            },
            {
            "type": "text",
            "id": "earrings_heading",
            "label": " Earings heading"
          },
            {
              "type": "image_picker",
              "id": "Earings_image",
              "label": "Earings Image"
            },
            {
              "type": "url",
              "id": "Earings_link",
              "label": "Button Url"
            }
            
          ],
          "presets": [
            {
                "name": "collection slider"
            }
          ]
        }
        {% endschema %}