<div class="split-container">
  <!-- Left Content Area -->
  <div class="content-container">
    <h1 >{{section.settings.ex_heading}}</h1>
    <p>{{section.settings.descrip}}</p>
  </div>

  <!-- Right Button Area -->
  <div class="button-container">
    <button class="collection-button" data-collection="rings">Rings</button>
    <button class="collection-button" data-collection="earrings">Earrings</button>
  </div>
</div>

<!-- Display Area for Collection -->
<div class="collection-display" id="collection-display">
  <p class="placeholder-text">Select a collection to display content here in full width.</p>
</div>

<!-- JavaScript to Handle Button Clicks -->
<script>
  document.querySelectorAll('.collection-button').forEach((button) => {
    button.addEventListener('click', () => {
      const collection = button.getAttribute('data-collection');
      
      // Clear the placeholder text
      document.getElementById('collection-display').innerHTML = '';

      // Dynamically insert collection content (testing placeholders here)
      if (collection === 'rings') {
        document.getElementById('collection-display').innerHTML = `
             {% assign rings_collection = collections[section.settings.rings_collection] %}
        {% if rings_collection and rings_collection.products.size > 0 %}
          {% for product in rings_collection.products %}   
            
              <div class="Ring-card" style="background-image: url({{ section.settings.Ring_image | img_url: 'master' }});">
              <div class="Ring-card-content">
                <h2>{{ section.settings.Ring_heading }}</h2>
                <a href="{{ section.settings.ring_link }}" class="button">View All Products</a>
              </div>
            </div>
            
              <div class="slide">
                
                <a href="{{ product.url }}">
                  <img src="{{ product.featured_image | img_url: '300x300' }}" alt="{{ product.title }}">
                </a>
                <div class="card-label">
                  {% if  product.tags contains "Quick Add"%}
              <span class="quick-add-label">Quick Add</span">
            {% elsif product.tags contains "Pre-order" %}
              <span class="pre-order-label">Pre-order</span>
            {% endif %}
              </div>
                <p class="product-title">{{ product.title }}</p>
                <p class="product-price">From {{ product.price | money }}</p>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p>No products in Rings collection.</p>
        {% endif %}
        
          <div class="collection-content">
            <h3>Rings Collection</h3>
            <p>This is the content for the Rings collection, displayed at full width.</p>
          </div>`
          
          
          ;
      } else if (collection === 'earrings') {
        document.getElementById('collection-display').innerHTML = `
          <div class="collection-content">
          Ring OR Earrings Content here?
            <h3>Earrings Collection</h3>
            <p>This is the content for the Earrings collection, displayed at full width.</p>
          </div>`;
      }
    });
  });
</script>
<style>
/* Main Container */
.split-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 50px;
}

/* Left Content Area */
.content-container {
  width: 50%;
  padding-right: 20px;
}

.content-container h2 {
  font-size: 36px;
  margin-bottom: 10px;
}

.content-container p {
  font-size: 18px;
  color: #555;
}

/* Right Button Area */
.button-container {
  width: 50%;
  text-align: right;
}

.button-container .collection-button {
  margin: 0 10px;
  padding: 10px 20px;
  font-size: 16px;
  border: 1px solid #000;
  background: none;
  cursor: pointer;
  transition: all 0.3s ease;
}

.button-container .collection-button:hover {
  background-color: #000;
  color: #fff;
}

/* Collection Display Area */
.collection-display {
  width: 100%;
  margin-top: 20px;
  padding: 20px;
  border-top: 1px solid #ddd;
}

.placeholder-text {
  text-align: center;
  font-size: 16px;
  color: #999;
}

.collection-content {
  text-align: center;
  padding: 50px 20px;
}

.collection-content h3 {
  font-size: 28px;
  margin-bottom: 10px;
}

.collection-content p {
  font-size: 18px;
  color: #555;
}
</style>
{% schema %}
{
    "name": "Product Tabs",
    "settings": [
         {
              "type": "text",
              "id": "ex_heading",
              "label": "Heading"
            },
            {
              "type": "text",
              "id": "descrip",
              "label": "Description"
            },
            {
              "type": "collection",
              "id": "rings_collection",
              "label": "Rings Collection"
            },
            {
              "type": "image_picker",
              "id": "Ring_image",
              "label": "Ring Image"
            },
            {
              "type": "text",
              "id": "Ring_heading",
              "label": " Ring heading"
            },
            {
              "type": "url",
              "id": "ring_link",
              "label": "Button Url"
            }
        ],
        "presets": [
            {
                "name": "Product Tabs"
            }
        ]
}
{% endschema %}