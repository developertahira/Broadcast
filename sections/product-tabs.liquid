<div class="split-container">
  <!-- Left Content Area -->
  <div class="content-container">
    <h1 class="pt-heading">{{section.settings.ex_heading}}</h1>
    <p class="pt-para">{{section.settings.descrip}}</p>
  </div>

  <!-- Right Button Area -->
  <div class="button-container">
    <button class="collection-button" data-collection="rings">{{section.settings.first_menu_name}}</button>
    <button class="collection-button" data-collection="earrings">{{section.settings.second_menu_name}}</button>
  </div>
</div>

<!-- Display Area for Collection -->
<div class="collection-display" id="collection-display">
  <p class="placeholder-text"></p>
</div>

<!-- JavaScript to Handle Button Clicks -->
<script>
  document.querySelectorAll('.collection-button').forEach((button) => {
    button.addEventListener('click', () => {
      const collection = button.getAttribute('data-collection');
      
      // Clear the placeholder text
      document.getElementById('collection-display').innerHTML = '';

      // Dynamically insert collection content (testing placeholders here)
      if (collection === 'rings') {
        document.getElementById('collection-display').innerHTML = `
          {% assign rings_collection = collections[section.settings.rings_collection] %}

          {% if rings_collection and rings_collection.products.size > 0 %}
            <div class="ring-slider">
              <div class="slider-container">
                <div class="Ring-card slide" style="background-image: url({{ section.settings.Ring_image | img_url: 'master' }});">
                  <div class="Ring-card-content">
                    <h2>{{ section.settings.Ring_heading }}</h2>
                    <a href="{{ section.settings.ring_link }}" class="button">{{section.settings.button_text}}</a>
                  </div>
                </div>

                {% for product in rings_collection.products %}
                  <div class="slide">
                    <a href="{{ product.url }}">
                      <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title }}">
                    </a>
                    <div class="card-label">
                      {% if  product.tags contains "Quick Add" %}
                        <span class="quick-add-label">Quick Add</span>
                      {% elsif product.tags contains "Pre-order" %}
                        <span class="pre-order-label">Pre-order</span>
                      {% endif %}
                    </div>
                    <p class="product-title">{{ product.title }}</p>
                    <p class="product-price">From {{ product.price | money }}</p>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% else %}
            <p>No products in Rings collection.</p>
          {% endif %}
        `;
      } else if (collection === 'earrings') {
        document.getElementById('collection-display').innerHTML = `
          {% assign earrings_collection = collections[section.settings.earrings_collection] %}

          {% if earrings_collection and earrings_collection.products.size > 0 %}
            <div class="ring-slider">
              <div class="slider-container">
                <div class="Ring-card slide" style="background-image: url({{ section.settings.Earings_image | img_url: 'master' }});">
                  <div class="Ring-card-content">
                    <h2>{{ section.settings.earrings_heading }}</h2>
                    <a href="{{ section.settings.Earings_link }}" class="button">{{section.settings.button_text}}</a>
                  </div>
                </div>

                {% for product in earrings_collection.products %}
                  <div class="slide">
                    <a href="{{ product.url }}">
                      <img src="{{ product.featured_image | img_url: '300x300' }}" alt="{{ product.title }}">
                    </a>
                    <div class="card-label">
                      {% if  product.tags contains "Quick Add" %}
                        <span class="quick-add-label">Quick Add</span>
                      {% elsif product.tags contains "Pre-order" %}
                        <span class="pre-order-label">Pre-order</span>
                      {% endif %}
                    </div>
                    <p class="product-title">{{ product.title }}</p>
                    <p class="product-price">From {{ product.price | money }}</p>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% else %}
            <p>No products in Earrings collection.</p>
          {% endif %}
        `;
      }
    });
  });
</script>
