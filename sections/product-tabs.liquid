<div class="product-tabs-main-container">
    <div class="product-heading-content">
        <h2 class="Excep-heading">{{section.settings.ex_heading}}</h2>
        <p class="Excep-Descrip">{{section.settings.Ex_Description}}</p>
    </div>
    <div class="product-tabs-menu-contain">
        <ul class="tabs-menu">
            <li class="tab-item" data-tab="rings">Rings</li>
            <li class="tab-item active" data-tab="earrings">Earrings</li>
        </ul>
    </div>
</div>
<div class="Tab-content"></div>
<div class="Tab-content"></div>
<style>
.product-tabs-main-container {
  display: flex;
  width: 100%;
  
}
  ul.tabs-menu {
    list-style: none;
    display: flex;
    justify-content: end;
    margin: 20px;
  }
.product-heading-content {
  width: 50%
}
  .product-tabs-menu-contain {
    width: 50%
  }
</style>
{% schema %}
{
    "name": "Product Tabs",
    "settings": [
        {
            "type": "text",
            "id": "ex_heading",
            "label": "Heading"
        },
        {
            "type": "text",
            "id": "Ex_Description",
            "label": "Description"
        }
        ],
        "presets": [
            {
                "name": "Product Tabs"
            }
        ]
}
{% endschema %}