<div class="product-tabs-main-container">
    <div class="product-heading-content">
        <h2 class="Excep-heading">{{section.settings.ex_heading}}</h2>
        <p class="Excep-Descrip">{{Section.settings.Ex_Description}}</p>
    </div>
    <div class="product-tabs-menu-contain">
        <ul class="tabs-menu">

            <li class="tab-item" data-tab="rings">Rings</li>
            <li class="tab-item active" data-tab="earrings">Earrings</li>
        </ul>
    
    </div>
</div>
<style>
    .product-tabs-menu-contain {
    margin-top: 20px;
}
.tabs-menu {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
}
.tab-item {
    margin-right: 20px;
    cursor: pointer;
    font-weight: 500;
    position: relative;
}
.tab-item.active {
    font-weight: bold;
    text-decoration: underline;
}
.tabs-content .tab-content {
    display: none;
}
.tabs-content .tab-content.active {
    display: block;
}

</style>
{% schema %}
{
    "name": "Product Tabs",
    "settings": [
        {
            "type": "text",
            "id": "ex_heading",
            "label": "Heading"
        },
        {
            "type": "text",
            "id": "Ex_Description",
            "label": "Description"
        }
        ],
        "presets": [
            {
                "name": "Product Tabs"
            }
        ]
}
{% endschema %}