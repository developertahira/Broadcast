{{ 'essential-collection.css' | asset_url | stylesheet_tag }}

<div class="Essential-collection">
  <div class="E-collect-contain">
    {% if section.settings.featured_products %}
      <div class="Esse-featured-products">
        {% for product in section.settings.featured_products %}
          <div class="Esse-product-item">
            
              <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title }}">
              <div class="card-label">
                {% if  product.tags contains "Quick Add" %}
            <span class="quick-add-label">Quick Add</span>
          {% elsif product.tags contains "Pre-order" %}
            <span class="pre-order-label">Pre-order</span>
          {% endif %}
            </div>
              <h3>{{ product.title }}</h3>
              <p>{{ product.price | money }}</p>
            
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p>No featured products selected.</p>
    {% endif %}
  </div>
  <div class="main-img-contain">
    {% if section.settings.eimage %}
      <img src="{{ section.settings.eimage | image_url: width: 800 }}" alt="Section Image">
    {% endif %}
    <div class="essen-overlay-text">
      <h1>{{section.settings.Es_heading}}</h1>
      <p>{{section.settings.Discription}}</p>
    </div>
  </div>
</div>


{% schema %}
{
    "name": "Essential Collection",
    "settings": [
        {
            "type": "image_picker",
            "id": "eimage",
            "label": "select image"
        },
        {
            "type": "product_list",
            "id": "featured_products",
            "label": "Select Featured Products",
            "info": "Choose products to feature"
            },
            {
              "type": "text",
              "id": "Es_heading",
              "label": "Heading"
            },
            {
              "type": "text",
              "id": "Discription",
             "label": "Enter Caption"
            }
        ],
        "presets": [
            {
                "name": "Essential Collection"
            }
        ]
}
{% endschema %}