                "id": "Days",
                "label": "Days"
            },
            {
                "type": "text",
                "id": "Hours",
                "label": "Hours"
            },
            {
                "type": "text",
                "id": "minutes",
                "label": "Minutes"
            },
            {
                "type": "text",
                "id": "seconds",
