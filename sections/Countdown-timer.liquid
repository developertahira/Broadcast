<div class="sale-counter-main-container" style="background-image: url('{{ section.settings.bg_img | img_url: 'master' }}'); ">
    <div class="innercontainer">
        <div class="counter-content">
            <p class="sale_Description">{{ section.settings.Scaptopn }}</p>
            <h1 class="sale_heading">{{ section.settings.Sheading }}</h1>
            {% if section.settings.button_text and section.settings.link_button %}
            <a href="{{ section.settings.link_button }}" class="custom-button">
                {{ section.settings.button_text }}
            </a>
            {% endif %}
        </div>

        {% if section.settings.countdown_date %}
        <div class="counters-container">
            <div class="counter">
                <span id="days"></span>
                <p>{{section.settings.Days}}</p>
            </div>
            <div class="counter">
                <span id="hours"></span>
                <p>{{section.settings.Hours}}</p>
            </div>
            <div class="counter">
                <span id="minutes"></span>
                <p>{{section.settings.minutes}}</p>
            </div>
            <div class="counter">
                <span id="seconds"></span>
                <p>{{section.settings.seconds}}</p>
            </div>
        </div>
        {% endif %}
    </div>
</div>

<style>
    .sale-counter-main-container {
        height: auto;
        position: relative;
        width: 100%;
        box-sizing: border-box;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        object-position: 37.4927% 34.5699%;
    }
    .counter-content {
        width: 100%;
    }
    .counter-content p, h1 {
        color: white;
    }
    .counter-content .sale_heading {
       margin-top: 0px;
       margin-bottom: 1rem;
       font-family: "IT Novarese", serif;
       font-weight: 400;
       line-height: 1.2;
    }
    .counter-content .sale_Description {
        margin-top: 0px;
        margin-bottom: 1rem;
        font-size: 16px;

    }
    .counters-container {
        width: 50%;
        display: inline-grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 12px;
        color: white;

    }
    .innercontainer {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin: 0px 72px;
        padding: 20px 0px 20px 0px;
        align-items: center;
    }
    .custom-button {
        display: inline-block;
        padding: 10px 20px;
        margin-top: 8px;
        margin-bottom: 1rem;
        color: white;
        text-decoration: none;
        font-size: 16px;
        border: 1px solid white;
    }

    .counter {
        text-align: center;
    }
    .counter span {
        display: block;
        padding: 10px 10px 0px 10px;
        font-size: 56px;
    }
    .counter p {
        font-size: 2.2rem;
        color: white;
        margin: 0;

    }
    .innercontainer{
        flex: 1;
    }
@media (min-width: 750px) {
    .innercontainer {
        height: 300px;
    }
}
    @media (max-width: 749px) {
    .counter-content .sale_heading {
        font-size: 30px;
        }
    .innercontainer {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 0px 20px; /* Adjust the margins to your preference */
        height: auto; /* Ensure the container can grow with content */
        overflow: hidden;
        padding: 42px 0px;
        gap: 0px;
    }
    .custom-button {
        padding: 12px 18px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px;
        line-height: 1.37;
        font-weight: 400;
        letter-spacing: 0.125em;
        text-transform: uppercase;

    }
    .counter-content {
        order: 1; /* This ensures that the content is displayed first (at the top) */
        text-align: center; /* Center the text */
    }

    .counters-container {
        order: 2; /* This ensures that the counter is displayed second (at the bottom) */
        display: flex;
        justify-content: center;
        gap: 6px;
    }

    .counter {
        text-align: center;
        flex: 1;
    }
    .counter span {
        padding-top: 0px;
    }
    .counter p {
        font-size: 1.9rem;
    }
    .counter span {
        font-size: 27px;
    }
}
@media (max-width: 600px) {
    .counters-container {
        gap: 12px;
    }
}

@media (max-width:990px) and (min-width:750px) {
    .counters-container {
        width: 100%;
    }
    .custom-button {
        padding: 16px 22px;
        font-size: 12px;
        font-family: sans-serif;
        line-height: 1.37;
        letter-spacing: 0.125em;
    }
    .counter span {
        font-size: 49px;
    }
    .innercontainer {
        margin: 0px 40px;
    }
}
@media (max-width: 800px) and (min-width: 751px) {
    .counter-content .sale_heading {
        margin-right: 7px;
    }
}
@media (max-width: 989px) and (min-width:960px) {
    .innercontainer {
        height: 270px;
    }
}
@media (max-width: 1299px) and (min-width:990px) {
    .counters-container {
        width: 90%;
    }
    .innercontainer {
        margin: 0px 45px 0px 89px;
    }
}
@media (max-width: 1100px) and (min-width: 1000) {
    .innercontainer {
        margin: 0px 23px 0px 50px;
    }
}
@media (min-width: 1450px) {
    .innercontainer {
        margin: 0px 212px;
    }
    .counters-container {
        width: 100%;
        gap: 58px;
        display: flex;
        justify-content: flex-end;
    }
}
@media (max-width: 1449px) and (min-width: 1300px) {
    .innercontainer {
        margin: 0px 169px;
    }
    .counters-container {
        width: 100%;
        gap: 58px;
        display: flex;
        justify-content: flex-end;
    }
}

</style>

<script>
    const countdownDateInput = "{{ section.settings.countdown_date }}";
    if (countdownDateInput) {
        const countdownDate = new Date(countdownDateInput).getTime();
        const timerInterval = setInterval(function () {
            const now = new Date().getTime();
            const distance = countdownDate - now;

            // Calculate time
            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            // Update the timer
            document.getElementById("days").innerHTML = days > 0 ? days : "00";
            document.getElementById("hours").innerHTML = hours > 0 ? hours : "00";
            document.getElementById("minutes").innerHTML = minutes > 0 ? minutes : "00";
            document.getElementById("seconds").innerHTML = seconds > 0 ? seconds : "00";

            // When the countdown is over
            if (distance < 0) {
                clearInterval(timerInterval);
                document.querySelector(".counters-container").innerHTML = "<p>Offer Expired</p>";
            }
        }, 1000);
    } else {
        // Remove the timer container if no date is provided
        const timerContainer = document.querySelector(".counters-container");
        if (timerContainer) {
            timerContainer.style.display = "none";
        }
    }
</script>

